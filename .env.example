# ── Required ─────────────────────────────────────────────────────────────────
# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ── Optional ─────────────────────────────────────────────────────────────────
# Groq model (default: llama-3.1-8b-instant)
GROQ_MODEL=openai/gpt-oss-120b

# SQLite database path (default: ./data/briefs.db)
BRIEF_DB_PATH=./data/briefs.db

# Global daily token cap (LLM10)
DAILY_TOKEN_CAP=500000

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: Serper.dev key for search_web tool
# SERPER_API_KEY=your-serper-api-key-here
