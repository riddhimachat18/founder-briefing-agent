# ── Required ─────────────────────────────────────────────────────────────────
# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional ─────────────────────────────────────────────────────────────────
# Gemini model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# SQLite database path (default: ./data/briefs.db)
BRIEF_DB_PATH=./data/briefs.db

# Global daily token cap — agent refuses once exceeded (LLM10)
DAILY_TOKEN_CAP=500000

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: Serper.dev key for search_web tool
# SERPER_API_KEY=your-serper-api-key-here
